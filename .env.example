# Replace ALL example secrets before deploying. Do not commit .env.
PORT=3000
PUBLIC_BASE_URL=https://pay.example.com
ADMIN_PASSWORD=choose-a-long-unique-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters
API_KEY=replace-with-a-long-random-api-key
# Optional. Only configure if you have a trusted bank/PSP-side verifier.
# SETTLEMENT_SECRET=replace-with-another-long-random-secret
DB_PATH=/app/data/gateway.sqlite
